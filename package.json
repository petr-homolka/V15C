{
  "name": "v15c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Systém doprovázení pěstounských rodin — návrh, datový model, testovací data",
  "scripts": {
    "typecheck": "tsc --noEmit -p schema/tsconfig.json && tsc --noEmit -p tools/seed/tsconfig.json",
    "emulator": "firebase emulators:start --only firestore,auth --project demo-v15c",
    "dev": "npm --prefix apps/crm run dev",
    "build": "npm --prefix apps/crm run build",
    "test:schema": "tsx tests/schema.test.mjs",
    "test": "npm run test:schema && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules \"node tests/rules.test.mjs\"",
    "seed": "npm --prefix tools/seed run seed",
    "seed:clear": "npm --prefix tools/seed run seed -- clear",
    "seed:reseed": "npm --prefix tools/seed run seed -- reseed",
    "seed:stats": "npm --prefix tools/seed run seed -- stats",
    "seed:dump": "npm --prefix tools/seed run seed -- dump",
    "install:app": "npm --prefix apps/crm install"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.0.0",
    "firebase": "^11.0.0",
    "firebase-tools": "^13.0.0",
    "tsx": "^4.23.11",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
